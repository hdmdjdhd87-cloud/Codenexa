# CodeNexa System — backend environment
# Скопируй в .env и заполни реальными значениями локально/в Railway.
# Этот файл в git — только с пустыми плейсхолдерами, реальный .env в git не коммитить.

# PostgreSQL (используется существующий Supabase Postgres, транзакционный pooler)
DATABASE_URL=

# SEC-002 (production-аудит 22.08.2026): опционально — Supabase project ref,
# на который ДОЛЖЕН указывать DATABASE_URL (например hbzomngnrwzltztlnynh).
# Если задано и не совпадает с фактическим ref в DATABASE_URL — приложение
# откажется стартовать (fail-fast), вместо того чтобы молча работать не с
# той БД (см. app/database.py: extract_supabase_project_ref). Оставь пустым,
# если такой защиты пока не нужно.
EXPECTED_DB_PROJECT_REF=

# Telegram Bot (используется ТОЛЬКО backend'ом для проверки подписи initData)
TELEGRAM_BOT_TOKEN=

# Разрешённые origin'ы фронтенда через запятую
CORS_ORIGINS=http://localhost:5173

# Подпись сессионных JWT, выдаваемых backend'ом после проверки Telegram initData
JWT_SECRET=

# Supabase (ТОЛЬКО если нужен прямой REST/Storage доступ — сейчас код этим
# не пользуется, реальное подключение к БД идёт через DATABASE_URL выше).
# ВАЖНО: не подставляй сюда project ref "по памяти" — сверься с реальным
# активным проектом в Supabase Dashboard. service_role — ТОЛЬКО backend,
# никогда не во frontend/VITE_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ENVIRONMENT=development
