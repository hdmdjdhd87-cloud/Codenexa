# CodeNexa System — backend environment
# Скопируй в .env и заполни реальными значениями локально/в Railway.
# Этот файл в git — только с пустыми плейсхолдерами, реальный .env в git не коммитить.

# PostgreSQL (используется существующий Supabase Postgres, транзакционный pooler)
DATABASE_URL=

# Telegram Bot (используется ТОЛЬКО backend'ом для проверки подписи initData)
TELEGRAM_BOT_TOKEN=

# Разрешённые origin'ы фронтенда через запятую
CORS_ORIGINS=http://localhost:5173

# Подпись сессионных JWT, выдаваемых backend'ом после проверки Telegram initData
JWT_SECRET=

# Supabase (используются существующий проект; service_role — ТОЛЬКО backend, никогда не VITE_*)
SUPABASE_URL=https://vlpgdiivliozzhacymaw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

ENVIRONMENT=development
